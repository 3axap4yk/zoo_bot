# Скопируйте в .env и заполните своими данными
BOT_TOKEN=your_bot_token_here
ADMIN_USERNAME=@zoo_manager
ADMIN_EMAIL=adoption@moscowzoo.ru
ADOPTION_LINK=https://moscowzoo.ru/adoption

# PostgreSQL
POSTGRES_USER=zoo_bot_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=zoo_bot_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Для локальной разработки (без Docker)
# POSTGRES_HOST=localhost